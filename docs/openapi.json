    "/api/v1/canchas/{id_cancha}/disponibilidad": {
      "get": {
        "tags": [
          "Disponibilidad"
        ],
        "summary": "Consultar",
        "description": "Devuelve todos los turnos de la cancha para la fecha, con su estado.\n\nEl header de respuesta `X-Cache` indica si el resultado salió de Redis (HIT)\no se calculó desde la base (MISS).",
        "operationId": "consultar_api_v1_canchas__id_cancha__disponibilidad_get",
        "parameters": [
          {
            "name": "id_cancha",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Id Cancha"
            }
          },
          {
            "name": "fecha",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "Fecha"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Disponibilidad"
                }
              }
            }
          },
          "404": {
            "description": "Cancha no encontrada"
          },
          "409": {
            "description": "La cancha está dada de baja"
          },
          "422": {
            "description": "Fecha inválida o pasada"
          }
        }
      }
    },
    "/api/v1/canchas/{id_cancha}/turnos/validar": {
      "get": {
        "tags": [
          "Integración con Reservas"
        ],
        "summary": "Validar",
        "description": "Indica si el turno existe y está disponible para reservar.\n\nSiempre responde 200 cuando los parámetros tienen formato válido;\nsi el turno no se puede reservar, `valido` es false y `motivo` explica por qué.\nSi es válido, devuelve además la hora de fin y el precio del turno.",
        "operationId": "validar_api_v1_canchas__id_cancha__turnos_validar_get",
        "parameters": [
          {
            "name": "id_cancha",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Id Cancha"
            }
          },
          {
            "name": "fecha",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "Fecha"
            }
          },
          {
            "name": "hora_inicio",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "time",
              "title": "Hora Inicio"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultadoValidacion"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Salud"
        ],
        "summary": "Health",
        "description": "Informa si el servicio y sus dependencias (DB, Redis, RabbitMQ) responden.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
