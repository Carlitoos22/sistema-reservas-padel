      "Cancha": {
        "properties": {
          "nombre": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Nombre",
            "examples": [
              "Cancha 1"
            ]
          },
          "tipo": {
            "$ref": "#/components/schemas/TipoCancha"
          },
          "techada": {
            "type": "boolean",
            "title": "Techada",
            "default": false
          },
          "precio_turno": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,8}|(?=[\\d.]{1,11}0*$)\\d{0,8}\\.\\d{0,2}0*$)",
            "title": "Precio Turno",
            "examples": [
              15000
            ]
          },
          "hora_apertura": {
            "type": "string",
            "format": "time",
            "title": "Hora Apertura",
            "examples": [
              "08:00"
            ]
          },
          "hora_cierre": {
            "type": "string",
            "format": "time",
            "title": "Hora Cierre",
            "examples": [
              "23:30"
            ]
          },
          "duracion_turno_min": {
            "type": "integer",
            "maximum": 180.0,
            "minimum": 30.0,
            "title": "Duracion Turno Min",
            "examples": [
              90
            ]
          },
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "activa": {
            "type": "boolean",
            "title": "Activa"
          }
        },
        "type": "object",
        "required": [
          "nombre",
          "tipo",
          "precio_turno",
          "hora_apertura",
          "hora_cierre",
          "duracion_turno_min",
          "id",
          "activa"
        ],
        "title": "Cancha"
      },
      "CanchaEntrada": {
        "properties": {
          "nombre": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Nombre",
            "examples": [
              "Cancha 1"
            ]
          },
          "tipo": {
            "$ref": "#/components/schemas/TipoCancha"
          },
          "techada": {
            "type": "boolean",
            "title": "Techada",
            "default": false
          },
          "precio_turno": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,8}|(?=[\\d.]{1,11}0*$)\\d{0,8}\\.\\d{0,2}0*$)"
              }
            ],
            "title": "Precio Turno",
            "examples": [
              15000
            ]
          },
          "hora_apertura": {
            "type": "string",
            "format": "time",
            "title": "Hora Apertura",
            "examples": [
              "08:00"
            ]
          },
          "hora_cierre": {
            "type": "string",
            "format": "time",
            "title": "Hora Cierre",
            "examples": [
              "23:30"
            ]
          },
          "duracion_turno_min": {
            "type": "integer",
            "maximum": 180.0,
            "minimum": 30.0,
            "title": "Duracion Turno Min",
            "examples": [
              90
            ]
          }
        },
        "type": "object",
        "required": [
          "nombre",
          "tipo",
          "precio_turno",
          "hora_apertura",
          "hora_cierre",
          "duracion_turno_min"
        ],
        "title": "CanchaEntrada"
      },
      "Disponibilidad": {
        "properties": {
          "cancha_id": {
            "type": "integer",
            "title": "Cancha Id"
          },
          "fecha": {
            "type": "string",
            "format": "date",
            "title": "Fecha"
          },
          "turnos": {
            "items": {
              "$ref": "#/components/schemas/Turno"
            },
            "type": "array",
            "title": "Turnos"
          }
        },
        "type": "object",
        "required": [
          "cancha_id",
          "fecha",
          "turnos"
        ],
        "title": "Disponibilidad"
      },
      "EstadoTurno": {
        "type": "string",
        "enum": [
          "libre",
          "bloqueado",
          "ocupado"
        ],
        "title": "EstadoTurno"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
