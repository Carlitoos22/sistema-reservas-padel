        "type": "string",
        "enum": [
          "CANCHA_INEXISTENTE",
          "CANCHA_INACTIVA",
          "FECHA_PASADA",
          "HORARIO_INVALIDO",
          "TURNO_BLOQUEADO"
        ],
        "title": "MotivoRechazo"
      },
      "ResultadoValidacion": {
        "properties": {
          "valido": {
            "type": "boolean",
            "title": "Valido"
          },
          "motivo": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MotivoRechazo"
              },
              {
                "type": "null"
              }
            ]
          },
          "cancha_id": {
            "type": "integer",
            "title": "Cancha Id"
          },
          "fecha": {
            "type": "string",
            "format": "date",
            "title": "Fecha"
          },
          "hora_inicio": {
            "type": "string",
            "format": "time",
            "title": "Hora Inicio"
          },
          "hora_fin": {
            "anyOf": [
              {
                "type": "string",
                "format": "time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hora Fin"
          },
          "precio_turno": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Precio Turno"
          }
        },
        "type": "object",
        "required": [
          "valido",
          "cancha_id",
          "fecha",
          "hora_inicio"
        ],
        "title": "ResultadoValidacion"
      },
      "TipoCancha": {
        "type": "string",
        "enum": [
          "cristal",
          "muro"
        ],
        "title": "TipoCancha"
      },
      "Turno": {
